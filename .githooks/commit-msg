#!/bin/sh
# Safety net: prefix non-conventional subjects with "misc:" so
# cocogitto keeps working. Still write real conventional commits.
msg=$(head -n1 "$1")
if ! echo "$msg" | grep -qE '^(feat|fix|chore|ci|docs|refactor|style|test|perf|revert|build|misc)(\(.*\))?!?: '; then
  printf 'misc: %s\n' "$msg" > "$1.tmp"
  tail -n +2 "$1" >> "$1.tmp"
  mv "$1.tmp" "$1"
fi
